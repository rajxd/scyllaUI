{
  "name": "scyllaui",
  "version": "0.1.0",
  "description": "Open-source ScyllaDB web client — browse tables, run CQL, manage connections",
  "main": "server.js",
  "scripts": {
    "test": "jest --runInBand",
    "start": "node server.js",
    "dev:server": "nodemon server.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npm install && npm run build",
    "setup": "npm install && npm run build",
    "postinstall": "echo \"Run 'npm run build' to build the frontend, then 'npm start' to launch.\""
  },
  "keywords": ["scylladb", "cassandra", "database", "client", "gui", "admin"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajxd/scyllaUI.git"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "cassandra-driver": "^4.7.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "setupFiles": ["./tests/setup.js"]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
